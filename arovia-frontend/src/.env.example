# Base URL of the Arovia Spring Boot backend.
# Leave empty for local development (Vite proxies /api to localhost:8080).
# For production on a different origin, set this to your backend URL.
VITE_API_BASE_URL=

# Google OAuth Client ID (Google Identity Services), used by the
# "Continue with Google" button on the Login/Signup pages.
# Leave empty to keep the button disabled with a friendly message.
VITE_GOOGLE_CLIENT_ID=
